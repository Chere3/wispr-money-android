{
  "mcpServers": {
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mobilenext/mobile-mcp@latest"],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "android-skills": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "android-skills-mcp"],
      "env": {}
    }
  }
}
